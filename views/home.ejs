<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= view === "drive" ? "My Drive" : view.charAt(0).toUpperCase() + view.slice(1) %> | Nexora Drive</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            fontFamily: {
              sans: ["Inter", "ui-sans-serif", "system-ui", "sans-serif"],
            },
          },
        },
      };
    </script>
    <script>
      const savedTheme = localStorage.getItem("theme");
      if (
        savedTheme === "dark" ||
        (!savedTheme && window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body
    class="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white transition-colors duration-300">
    <%
      const titles = { drive: "My Drive", recent: "Recent", starred: "Starred", trash: "Trash" };
      const emptyCopy = {
        drive: "📂 Your Drive is ready! Upload your first file to get started.",
        recent: "🕒 No recent files",
        starred: "⭐ No starred files yet",
        trash: "🗑️ Trash is empty",
      };
      const nav = [
        { id: "drive", href: "/home", label: "My Drive", icon: "📁" },
        { id: "recent", href: "/home?view=recent", label: "Recent", icon: "🕒" },
        { id: "starred", href: "/home?view=starred", label: "Starred", icon: "⭐" },
        { id: "trash", href: "/home?view=trash", label: "Trash", icon: "🗑️" },
      ];
      const returnTo = view === "drive" ? "/home" : "/home?view=" + view;
      const usedMb = (files.reduce((total, file) => total + file.size, 0) / (1024 * 1024)).toFixed(2);
      const initial = (user.first_name || "U").charAt(0).toUpperCase();

      function formatSize(bytes) {
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
        return (bytes / (1024 * 1024)).toFixed(1) + " MB";
      }

      function iconFor(type) {
        if (type.startsWith("image/")) return { icon: "🖼️", wrap: "bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300" };
        if (type === "application/pdf") return { icon: "📄", wrap: "bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300" };
        if (type.startsWith("video/")) return { icon: "🎬", wrap: "bg-purple-100 text-purple-700 dark:bg-purple-950 dark:text-purple-300" };
        if (type.startsWith("audio/")) return { icon: "🎵", wrap: "bg-green-100 text-green-700 dark:bg-green-950 dark:text-green-300" };
        if (type.includes("zip") || type.includes("rar")) return { icon: "🗜️", wrap: "bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300" };
        if (type.includes("word") || type.includes("document")) return { icon: "📝", wrap: "bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300" };
        return { icon: "📁", wrap: "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300" };
      }
    %>

    <aside
      class="fixed inset-y-0 left-0 z-30 hidden w-64 flex-col border-r border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 lg:flex">
      <a href="/home" class="mb-8 flex items-center gap-3">
        <span
          class="flex h-10 w-10 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-600 text-sm font-bold text-white shadow-sm">
          N
        </span>
        <span class="text-lg font-semibold">Nexora Drive</span>
      </a>

      <nav class="space-y-1">
        <% nav.forEach(function (item) { %>
        <a
          href="<%= item.href %>"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium <%= view === item.id ? 'bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800' %>">
          <span><%= item.icon %></span>
          <span><%= item.label %></span>
        </a>
        <% }) %>
      </nav>

      <div class="mt-auto space-y-3">
        <a
          href="/user/logout"
          class="block rounded-xl px-3 py-2 text-sm font-medium text-slate-500 transition hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950 dark:hover:text-red-300">
          Log out
        </a>
        <p class="px-3 text-xs text-slate-400">© 2026 Nexora Drive</p>
      </div>
    </aside>

    <div class="lg:pl-64">
      <header
        class="sticky top-0 z-20 border-b border-slate-200/80 bg-slate-50/90 px-4 py-4 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90 sm:px-8">
        <div class="flex flex-wrap items-center gap-3">
          <label class="relative min-w-[16rem] flex-1">
            <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">⌕</span>
            <input
              id="file-search"
              type="search"
              placeholder="Search your files..."
              class="w-full rounded-2xl border border-slate-200 bg-white py-2.5 pl-9 pr-3 text-sm outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 dark:border-slate-800 dark:bg-slate-900" />
          </label>

          <button
            type="button"
            data-theme-toggle
            onclick="toggleTheme()"
            class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm shadow-sm dark:border-slate-800 dark:bg-slate-900"
            aria-label="Toggle color theme">
            🌙
          </button>

          <div class="flex items-center gap-3">
            <span
              class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 text-sm font-semibold text-white">
              <%= initial %>
            </span>
            <div class="leading-tight">
              <p class="text-sm font-semibold"><%= user.first_name || "You" %></p>
              <a href="/user/logout" class="text-xs text-slate-500 hover:text-red-600 dark:text-slate-400">Log out</a>
            </div>
          </div>
        </div>

        <!-- Same links as the sidebar, for screens that hide it -->
        <nav class="mt-4 flex gap-2 overflow-x-auto lg:hidden">
          <% nav.forEach(function (item) { %>
          <a
            href="<%= item.href %>"
            class="shrink-0 rounded-full px-3 py-1.5 text-sm font-medium <%= view === item.id ? 'bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300' : 'bg-white text-slate-600 dark:bg-slate-900 dark:text-slate-300' %>">
            <%= item.icon %> <%= item.label %>
          </a>
          <% }) %>
        </nav>
      </header>

      <main class="mx-auto max-w-5xl px-4 py-8 sm:px-8">
        <div class="mb-8">
          <h1 class="text-3xl font-semibold tracking-tight"><%= titles[view] %></h1>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Your files, in one place.</p>
        </div>

        <% if (error) { %>
        <p class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-200">
          <%= error %>
        </p>
        <% } %>

        <% if (view !== "trash") { %>
        <section class="mb-10 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <h2 class="text-sm font-semibold">Upload</h2>
          <form id="upload-form" action="/file/upload" method="POST" enctype="multipart/form-data" class="mt-4">
            <label
              id="dropzone"
              for="drive-file"
              class="flex cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center transition hover:border-indigo-400 hover:bg-indigo-50/60 hover:shadow-[0_0_0_6px_rgba(99,102,241,0.12)] dark:border-slate-700 dark:bg-slate-950 dark:hover:border-indigo-500 dark:hover:bg-indigo-950/30">
              <span class="text-3xl">☁️</span>
              <span class="mt-3 text-sm font-medium">Click to upload or drag and drop</span>
              <span class="mt-1 text-xs text-slate-500 dark:text-slate-400">Images, PDF, docs, audio, video, or zip. Max 10 MB.</span>
              <span id="file-name" class="mt-3 text-sm font-medium text-indigo-600 dark:text-indigo-300">No file selected</span>
              <input id="drive-file" name="file" type="file" class="hidden" />
            </label>
            <button
              id="upload-button"
              type="submit"
              disabled
              class="mt-4 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:text-slate-500 dark:disabled:bg-slate-700 dark:disabled:text-slate-400">
              Upload
            </button>
          </form>
        </section>
        <% } %>

        <section>
          <div class="mb-4 flex flex-wrap items-end justify-between gap-2">
            <h2 class="text-lg font-semibold">Your Files</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">
              <%= files.length %> file<%= files.length === 1 ? "" : "s" %> · <%= usedMb %> MB used
            </p>
          </div>

          <% if (!files.length) { %>
          <div class="rounded-2xl border border-slate-200 bg-white px-6 py-16 text-center shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <p class="text-base font-medium"><%= emptyCopy[view] %></p>
          </div>
          <% } else { %>
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <% files.forEach(function (file) { %>
            <% const meta = iconFor(file.mimetype || ""); %>
            <article
              data-file-row
              data-name="<%= file.originalName.toLowerCase() %>"
              class="group flex flex-col gap-3 border-b border-slate-100 px-4 py-4 last:border-b-0 dark:border-slate-800 sm:flex-row sm:items-center">
              <div class="flex min-w-0 flex-1 items-center gap-3">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl text-lg <%= meta.wrap %>">
                  <%= meta.icon %>
                </span>
                <div class="min-w-0">
                  <p class="truncate font-medium"><%= file.originalName %></p>
                  <p class="text-xs text-slate-500 dark:text-slate-400">
                    <%= formatSize(file.size) %>
                    ·
                    <%= new Date(file.createdAt).toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" }) %>
                  </p>
                </div>
              </div>

              <div class="flex flex-wrap items-center gap-2 sm:opacity-100 md:opacity-0 md:transition md:group-hover:opacity-100">
                <form action="/file/star/<%= file._id %>" method="POST">
                  <input type="hidden" name="returnTo" value="<%= returnTo %>" />
                  <button
                    type="submit"
                    class="rounded-lg px-2.5 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800">
                    <%= file.starred ? "★ Starred" : "☆ Star" %>
                  </button>
                </form>

                <a
                  href="/files/<%= file.storedName %>"
                  download="<%= file.originalName %>"
                  class="rounded-lg px-2.5 py-1.5 text-sm font-medium text-indigo-600 hover:bg-indigo-50 dark:text-indigo-300 dark:hover:bg-indigo-950">
                  ⬇ Download
                </a>

                <% if (!file.trashed) { %>
                <form action="/file/trash/<%= file._id %>" method="POST">
                  <input type="hidden" name="returnTo" value="<%= returnTo %>" />
                  <button
                    type="submit"
                    class="rounded-lg px-2.5 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800">
                    🗑 Trash
                  </button>
                </form>
                <% } else { %>
                <form action="/file/restore/<%= file._id %>" method="POST">
                  <input type="hidden" name="returnTo" value="<%= returnTo %>" />
                  <button
                    type="submit"
                    class="rounded-lg px-2.5 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800">
                    Restore
                  </button>
                </form>
                <form
                  action="/file/permanent-delete/<%= file._id %>"
                  method="POST"
                  onsubmit="return confirm('Delete this file forever?')">
                  <input type="hidden" name="returnTo" value="<%= returnTo %>" />
                  <button type="submit" class="rounded-lg px-2.5 py-1.5 text-sm font-medium text-red-600 hover:bg-red-50 dark:hover:bg-red-950">
                    Delete forever
                  </button>
                </form>
                <% } %>
              </div>
            </article>
            <% }) %>
          </div>
          <p id="search-empty" class="mt-4 hidden rounded-2xl border border-dashed border-slate-300 px-4 py-8 text-center text-sm text-slate-500 dark:border-slate-700">
            No files match that search.
          </p>
          <% } %>
        </section>
      </main>
    </div>

    <script>
      const fileInput = document.getElementById("drive-file");
      const fileName = document.getElementById("file-name");
      const uploadButton = document.getElementById("upload-button");
      const dropzone = document.getElementById("dropzone");

      function showSelectedFile() {
        if (!fileInput || !fileInput.files.length) {
          if (fileName) fileName.textContent = "No file selected";
          if (uploadButton) uploadButton.disabled = true;
          return;
        }

        fileName.textContent = fileInput.files[0].name;
        uploadButton.disabled = false;
      }

      if (fileInput) {
        fileInput.addEventListener("change", showSelectedFile);
      }

      if (dropzone) {
        ["dragenter", "dragover"].forEach((eventName) => {
          dropzone.addEventListener(eventName, (event) => {
            event.preventDefault();
            dropzone.classList.add("border-indigo-500");
          });
        });

        ["dragleave", "drop"].forEach((eventName) => {
          dropzone.addEventListener(eventName, (event) => {
            event.preventDefault();
            dropzone.classList.remove("border-indigo-500");
          });
        });

        dropzone.addEventListener("drop", (event) => {
          const dropped = event.dataTransfer.files;
          if (!dropped.length) return;
          fileInput.files = dropped;
          showSelectedFile();
        });
      }

      const search = document.getElementById("file-search");
      const searchEmpty = document.getElementById("search-empty");

      if (search) {
        search.addEventListener("input", () => {
          const query = search.value.trim().toLowerCase();
          let visible = 0;

          document.querySelectorAll("[data-file-row]").forEach((row) => {
            const match = row.dataset.name.includes(query);
            row.classList.toggle("hidden", !match);
            if (match) visible += 1;
          });

          if (searchEmpty) {
            searchEmpty.classList.toggle("hidden", visible !== 0 || query.length === 0);
          }
        });
      }

      function toggleTheme() {
        const root = document.documentElement;
        root.classList.toggle("dark");
        localStorage.setItem("theme", root.classList.contains("dark") ? "dark" : "light");
        syncThemeButton();
      }

      function syncThemeButton() {
        const dark = document.documentElement.classList.contains("dark");
        document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
          button.textContent = dark ? "☀️" : "🌙";
        });
      }

      syncThemeButton();
    </script>
  </body>
</html>
